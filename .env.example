NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
DATABASE_PROVIDER=sqlite
DATABASE_URL=./data/sivan-escrow-agent.db
POSTGRES_DATABASE_URL=
POSTGRES_SSL=true
POSTGRES_CONNECTION_TIMEOUT_MS=5000
POSTGRES_QUERY_TIMEOUT_MS=8000
TRUST_PROXY_HOPS=1
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_PROFILE_SESSION_SAMPLE_RATE=0
SENTRY_ENABLE_LOGS=false
SENTRY_SEND_DEFAULT_PII=false
SENTRY_DEBUG_ENDPOINT_ENABLED=false
OPERATIONS_ALERT_WEBHOOK_URL=
OPERATIONS_ALERT_WEBHOOK_SECRET=
OPERATIONS_ALERT_PROVIDER=
TELEGRAM_ALERT_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
TWILIO_DEBUGGER_WEBHOOK_SECRET=

# Backend ingress/admin security
ADMIN_API_KEY=change-me-to-a-strong-admin-secret
ADMIN_IP_ALLOWLIST=
CORE_API_SECRET=change-me-to-the-same-value-used-by-whatsapp-bot
CORE_API_IP_ALLOWLIST=
PAYOUT_ENCRYPTION_KEY=change-me-32-byte-random-secret
PAYOUT_TOKEN_SECRET=change-me-separate-hmac-secret
PAYOUT_SHARED_ACCOUNT_REVIEW_COUNT=2
NAIRA_HIGH_VALUE_REVIEW_AMOUNT=500000
USDC_HIGH_VALUE_REVIEW_AMOUNT=2500
COMPLIANCE_NEW_SELLER_ESCROW_COUNT=1
COMPLIANCE_HIGH_DISPUTE_RATIO=0.3
COMPLIANCE_HIGH_DISPUTE_MIN_ESCROWS=3

# Synapse SDK / SAP / x402
SYNAPSE_API_KEY=your-synapse-api-key
SYNAPSE_RPC_URL=https://staging.oobeprotocol.ai:8080/rpc
SYNAPSE_WS_URL=
SYNAPSE_GRPC_URL=
SYNAPSE_X402_FACILITATOR_URL=https://facilitator.payai.network
SYNAPSE_X402_NETWORK=solana-devnet
SYNAPSE_USDC_MINT=

# SAP wallet identity
SAP_RPC_URL=
SAP_AGENT_PRIVATE_KEY=your-sap-agent-private-key
SAP_AGENT_PUBLIC_KEY=your-sap-agent-public-key

# Ace Data Cloud
ACE_DATA_API_KEY=your-ace-data-cloud-api-key
ACE_DATA_BASE_URL=https://api.acedata.cloud

# Legacy x402 aliases; leave blank unless your facilitator requires separate credentials.
X402_RPC_URL=
X402_CLIENT_ID=
X402_CLIENT_SECRET=

# Production settlement verification; status probe is safest by default.
SETTLEMENT_VERIFY_TASK_TYPE=content-creation
SETTLEMENT_PROOF_OUTPUT=./data/settlement-verification-proof.json
SAP_VERIFY_REGISTER_AGENT=false
X402_VERIFY_PAYMENT_ID=
X402_VERIFY_CREATE_PAYMENT=false
X402_VERIFY_AMOUNT=0.01
X402_VERIFY_RECIPIENT=

# Paystack / Naira bridge
PAYSTACK_SECRET_KEY=your-paystack-secret-key
PAYSTACK_PUBLIC_KEY=your-paystack-public-key
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_WEBHOOK_SECRET=your-paystack-webhook-secret
PAYSTACK_RECEIVER_ACCOUNT=your-paystack-receiver-account
NAIRA_PAYMENT_METHODS=bank_transfer
PAYSTACK_CHANNELS=bank_transfer
PAYSTACK_CALLBACK_URL=https://yourapp.example.com/payment/callback
PAYSTACK_TIMEOUT_MS=8000
# Controlled E2E testing only. Requires PAYSTACK_SECRET_KEY=sk_test_... and an exact account allowlist.
PAYOUT_VERIFICATION_TEST_MODE=false
PAYOUT_VERIFICATION_TEST_ACCOUNT_NUMBERS=
PAYOUT_VERIFICATION_TEST_WHATSAPP_NUMBERS=

# Naira payment provider hierarchy. Paystack is DISABLED pending approval — keep the adapter
# but do not set it as active. Re-enable once licensing is confirmed.
# Paystack client/adapter is kept in code for future re-activation.
ACTIVE_PAYMENT_PROVIDER=flutterwave
BACKUP_PAYMENT_PROVIDER=palmpay
EMERGENCY_PAYMENT_PROVIDER=flutterwave
PAYMENT_PROVIDER_FALLBACK_ENABLED=false
ACTIVE_PAYOUT_PROVIDER=manual_bank_transfer
# Dynamic Platform Settings are now managed in the database via the Admin Hub.
# (PLATFORM_MODE, MAINTENANCE_MESSAGE, and Naira funding window configurations are no longer needed in .env)
PAYMENT_LIFECYCLE_WORKER_ENABLED=false
PAYMENT_LIFECYCLE_WORKER_INTERVAL_MS=300000
PAYMENT_LIFECYCLE_WORKER_BATCH_SIZE=250
RECONCILIATION_WORKER_ENABLED=false
RECONCILIATION_WORKER_INITIAL_DELAY_MS=60000
RECONCILIATION_WORKER_INTERVAL_MS=86400000
RECONCILIATION_LOOKBACK_HOURS=24
RECONCILIATION_PROVIDERS=paystack,monnify,palmpay,flutterwave
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_TIMEOUT_MS=8000
MONNIFY_CONTRACT_CODE=
MONNIFY_PAYMENT_METHODS=bank_transfer
MONNIFY_WEBHOOK_URL=https://yourapp.example.com/webhooks/monnify
MONNIFY_SOURCE_ACCOUNT_NUMBER=

# PalmPay primary collection. Bank transfer only; amount is converted to kobo before sending to PalmPay.
PALMPAY_APP_NAME=Sivan Escrow
PALMPAY_APP_ID=
PALMPAY_MERCHANT_ID=
PALMPAY_MERCHANT_PRIVATE_KEY=
PALMPAY_MERCHANT_PUBLIC_KEY=
PALMPAY_PLATFORM_PUBLIC_KEY=
PALMPAY_WHITELIST_IP=74.220.48.0/24,74.220.56.0/24
PALMPAY_BASE_URL=https://open-gw-sandbox.palmpay-inc.com
PALMPAY_WEBHOOK_URL=https://yourapp.example.com/webhooks/palmpay
PALMPAY_CALLBACK_URL=https://yourapp.example.com/payment/callback
PALMPAY_COUNTRY_CODE=NG
PALMPAY_TIMEOUT_MS=8000
PALMPAY_PAYMENT_METHODS=bank_transfer
PALMPAY_ORDER_EXPIRE_SECONDS=1800
PALMPAY_PAYOUT_ENABLED=false
PALMPAY_PAYOUT_NOTIFY_URL=https://yourapp.example.com/webhooks/palmpay/payout
PALMPAY_PROOF_AMOUNT=100
PALMPAY_PROOF_ORDER_ID=
PALMPAY_PROOF_USER_ID=palmpay-proof@sivan.local
PALMPAY_PROOF_RUN_PAYOUT=false
PALMPAY_PROOF_PAYEE_NAME=
PALMPAY_PROOF_PAYEE_BANK_CODE=
PALMPAY_PROOF_PAYEE_ACCOUNT_NUMBER=
PALMPAY_PROOF_PAYOUT_AMOUNT=100
PALMPAY_PROOF_PAYOUT_ORDER_ID=

# Flutterwave emergency backup collection. Bank transfer only; do not enable card collection.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com
FLUTTERWAVE_WEBHOOK_SECRET=
FLUTTERWAVE_WEBHOOK_URL=https://yourapp.example.com/webhooks/flutterwave
FLUTTERWAVE_TIMEOUT_MS=8000
FLUTTERWAVE_PAYMENT_METHODS=bank_transfer
FLUTTERWAVE_DYNAMIC_ACCOUNT_EXPIRY_SECONDS=3600

# Nomba transfer-only payout rail. Do not use for card/checkout pay-in.
NOMBA_CLIENT_ID=
NOMBA_CLIENT_SECRET=
NOMBA_ACCOUNT_ID=
NOMBA_BASE_URL=https://sandbox.nomba.com
NOMBA_WEBHOOK_URL=https://yourapp.example.com/webhooks/nomba
NOMBA_WEBHOOK_SECRET=
NOMBA_TIMEOUT_MS=8000
NOMBA_PAYOUT_ENABLED=false
NOMBA_SENDER_NAME=Sivan
NOMBA_SUB_ACCOUNT_ID=
NOMBA_PROOF_ACCOUNT_NUMBER=
NOMBA_PROOF_BANK_CODE=
NOMBA_PROOF_AMOUNT=100
NOMBA_PROOF_RUN_TRANSFER=false
NOMBA_PROOF_MERCHANT_TX_REF=

# Delivery proof policy. Keep false for MVP to avoid phishing/spam risk in WhatsApp proof submissions.
DELIVERY_PROOF_ALLOW_EXTERNAL_LINKS=false
WEBHOOK_URL=http://localhost:4000/webhooks/paystack
SMOKE_BASE_URL=http://localhost:4000
SMOKE_ADMIN_API_KEY=
SMOKE_REQUIRE_SETTLEMENT_PROOF=false
ADMIN_PAGE_SMOKE_BASE_URL=http://localhost:4000
ADMIN_PAGE_SMOKE_ADMIN_API_KEY=
ADMIN_PAGE_AUTH_BASE_URL=http://localhost:3600
ADMIN_PAGE_AUTH_JWT=
ADMIN_PAGE_AUTH_JWT_SECRET=

# Backup and disaster recovery operations
BACKUP_PROVIDER=neon-postgres-pitr
BACKUP_RETENTION_DAYS=7
BACKUP_POLICY_URL=
BACKUP_RESTORE_RUNBOOK_URL=docs/disaster-recovery.md
BACKUP_RESTORE_TEST_MAX_AGE_DAYS=30
BACKUP_LAST_RESTORE_TEST_AT=
BACKUP_LAST_RESTORE_TEST_STATUS=not_recorded
ROLLBACK_RELEASE_URL=
OUTAGE_STATUS_PAGE_URL=
OUTAGE_CONTACTS=
DR_BASE_URL=http://localhost:4000
DR_ADMIN_API_KEY=
DR_REQUIRE_FRESH_RESTORE=true

# Retry worker and stuck-escrow operations
QUEUE_WORKER_ENABLED=false
QUEUE_WORKER_INTERVAL_MS=15000
QUEUE_WORKER_BATCH_SIZE=5
QUEUE_LOCK_TIMEOUT_SECONDS=300
QUEUE_RETRY_BASE_DELAY_MS=30000
QUEUE_RETRY_MAX_DELAY_MS=1800000
STUCK_ESCROW_ALERT_MINUTES=1440

# Abuse prevention tuning
ABUSE_BLOCK_SCORE=95
ABUSE_REVIEW_SCORE=60
ABUSE_ESCROW_VELOCITY_LIMIT=8
ABUSE_HIGH_AMOUNT_NAIRA=1000000
ABUSE_HIGH_AMOUNT_USDC=5000
ABUSE_TREND_ALERT_MIN_SIGNALS=5

# WhatsApp bot notification callback
NOTIFICATION_URL=http://localhost:3000
NOTIFICATION_SECRET=change-me-to-the-same-value-used-by-whatsapp-bot

# Optional local demo runner values. Keep blank in production; real escrows come from API/WhatsApp/admin input.
# AGENT_TASK_TYPE=content-creation
# USER_PAYMENT_PREFERENCE=NAIRA
# USER_EMAIL=buyer@example.com
# PAYMENT_AMOUNT=50
# TASK_INSTRUCTIONS=Write a product description for a trustless escrow service.
# USDC_CHANNEL=x402

# Optional frontend
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:4000
